#!/usr/bin/env bash
# kit-friend: управление клиентами (друзьями) для AmneziaWG
# Создает персональные конфиги и QR-коды с защитой от слива IP в Госуслуги и банки
set -euo pipefail

. /etc/server-kit/config.env 2>/dev/null || true

AWG_CONTAINER="amnezia-awg2"
AWG_CONF="/opt/amnezia/awg/awg0.conf"
AWG_PSK="/opt/amnezia/awg/wireguard_psk.key"
CONFIGS_DIR="/var/lib/server-kit/friends"
mkdir -p "$CONFIGS_DIR"

# Функция получения внешнего IP сервера
get_server_endpoint() {
  local ip
  ip="$(curl -4 -s -m 5 https://ifconfig.me 2>/dev/null || curl -4 -s -m 5 https://api.ipify.org || true)"
  [ -n "$ip" ] || ip="$(hostname -I | awk '{print $1}')"
  echo "$ip"
}

# Проверка наличия AmneziaWG (контейнер или хост)
check_awg_installed() {
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${AWG_CONTAINER}$"; then
    return 0
  fi
  if command -v awg >/dev/null 2>&1 && [ -f "$AWG_CONF" ]; then
    return 0
  fi
  return 1
}

# Выполнение команды awg (внутри докера или локально)
awg_exec() {
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -q "^${AWG_CONTAINER}$"; then
    docker exec "$AWG_CONTAINER" "$@"
  else
    "$@"
  fi
}

# Поиск свободного IP в подсети 10.8.1.0/24
find_next_ip() {
  local used_ips
  if [ -f "$AWG_CONF" ]; then
    used_ips=$(grep -oE "10\.8\.1\.[0-9]+" "$AWG_CONF" | awk -F. '{print $4}' | sort -n | uniq)
  else
    used_ips=$(awg_exec awg show awg0 allowed-ips 2>/dev/null | grep -oE "10\.8\.1\.[0-9]+" | awk -F. '{print $4}' | sort -n | uniq || echo "1")
  fi

  for i in $(seq 8 250); do
    if ! echo "$used_ips" | grep -qx "$i"; then
      echo "10.8.1.$i"
      return 0
    fi
  done
  echo "10.8.1.250"
}

# Список заблокированных подсетей для режима "Smart / Без палева"
SMART_ALLOWED_IPS="157.240.0.0/16, 57.144.0.0/16, 31.13.0.0/16, 179.60.192.0/22, 185.60.216.0/22, 129.134.0.0/16, 91.108.4.0/22, 91.108.8.0/22, 91.108.12.0/22, 91.108.16.0/22, 91.108.56.0/22, 149.154.160.0/20, 172.217.0.0/16, 142.250.0.0/15, 216.58.192.0/19, 74.125.0.0/16, 64.233.160.0/19, 104.244.42.0/21, 162.158.0.0/15, 66.22.196.0/22, 1.1.1.1/32, 8.8.8.8/32"

cmd_add() {
  local name="${1:-}"
  local mode="${2:-smart}" # smart или full

  if [ -z "$name" ]; then
    echo "Использование: kit-friend add <ИМЯ> [smart|full]"
    echo "  smart (по умолчанию) — безопасный: через VPN идут только Instagram, YouTube, Telegram, Discord."
    echo "                         Госуслуги, банки (Сбер, Т-Банк) идут напрямую (твой IP не палится!)."
    echo "  full                 — полный туннель (весь трафик 0.0.0.0/0 идет через VPN)."
    exit 1
  fi

  # Очистка имени
  name="$(echo "$name" | tr -cd 'a-zA-Z0-9_-')"
  [ -n "$name" ] || { echo "Некорректное имя друга"; exit 1; }

  if ! check_awg_installed; then
    echo "Ошибка: AmneziaWG не найдена на этом сервере (контейнер $AWG_CONTAINER не запущен)."
    exit 1
  fi

  local client_ip
  client_ip="$(find_next_ip)"
  echo "Назначаем IP: $client_ip для друга: $name"

  # Генерация ключей
  local priv pub psk
  priv="$(awg_exec awg genkey)"
  pub="$(echo "$priv" | awg_exec awg pubkey)"

  # Читаем PSK сервера
  if [ -f "$AWG_PSK" ]; then
    psk="$(cat "$AWG_PSK")"
  elif [ -f "$AWG_CONF" ] && grep -q "PresharedKey" "$AWG_CONF"; then
    psk="$(grep -m1 "PresharedKey" "$AWG_CONF" | cut -d= -f2 | tr -d ' ')"
  else
    psk="$(awg_exec awg genpsk)"
  fi

  # Параметры сервера
  local server_pub server_port jc jmin jmax s1 s2 s3 s4 h1 h2 h3 h4
  server_pub="$(awg_exec awg show awg0 public-key 2>/dev/null || true)"
  server_port="$(awg_exec awg show awg0 listen-port 2>/dev/null || true)"
  server_port="${server_port:-41695}"

  # Читаем обфускацию из существующего конфига
  if [ -f "$AWG_CONF" ]; then
    jc="$(grep -m1 "^Jc" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "6")"
    jmin="$(grep -m1 "^Jmin" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "10")"
    jmax="$(grep -m1 "^Jmax" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "50")"
    s1="$(grep -m1 "^S1" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "66")"
    s2="$(grep -m1 "^S2" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "59")"
    s3="$(grep -m1 "^S3" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "11")"
    s4="$(grep -m1 "^S4" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "8")"
    h1="$(grep -m1 "^H1" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "63849548-1578275308")"
    h2="$(grep -m1 "^H2" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "2062785959-2143305456")"
    h3="$(grep -m1 "^H3" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "2144750020-2146610903")"
    h4="$(grep -m1 "^H4" "$AWG_CONF" 2>/dev/null | cut -d= -f2 | tr -d ' ' || echo "2147175206-2147460375")"
  else
    jc=6; jmin=10; jmax=50; s1=66; s2=59; s3=11; s4=8
    h1="63849548-1578275308"; h2="2062785959-2143305456"
    h3="2144750020-2146610903"; h4="2147175206-2147460375"
  fi

  local server_ip
  server_ip="$(get_server_endpoint)"

  local allowed_ips
  if [ "$mode" = "full" ]; then
    allowed_ips="0.0.0.0/0"
  else
    allowed_ips="$SMART_ALLOWED_IPS"
  fi

  # Добавляем пира на лету в работающий awg0
  tmp_psk_file="/tmp/psk_${name}.key"
  echo "$psk" > "$tmp_psk_file"
  awg_exec awg set awg0 peer "$pub" preshared-key "$tmp_psk_file" allowed-ips "${client_ip}/32" 2>/dev/null || true
  rm -f "$tmp_psk_file"

  # Сохраняем в постоянный awg0.conf
  if [ -f "$AWG_CONF" ] && ! grep -q "$pub" "$AWG_CONF"; then
    cat >> "$AWG_CONF" <<PEER

# Friend: ${name} (${client_ip}) [Mode: ${mode}]
[Peer]
PublicKey = ${pub}
PresharedKey = ${psk}
AllowedIPs = ${client_ip}/32
PEER
  fi

  # Формируем клиентский .conf файл
  local conf_file="${CONFIGS_DIR}/${name}.conf"
  local qr_file="${CONFIGS_DIR}/${name}.png"

  cat > "$conf_file" <<CLIENT
[Interface]
Address = ${client_ip}/32
DNS = 1.1.1.1, 8.8.8.8
PrivateKey = ${priv}
Jc = ${jc}
Jmin = ${jmin}
Jmax = ${jmax}
S1 = ${s1}
S2 = ${s2}
S3 = ${s3}
S4 = ${s4}
H1 = ${h1}
H2 = ${h2}
H3 = ${h3}
H4 = ${h4}

[Peer]
PublicKey = ${server_pub}
PresharedKey = ${psk}
AllowedIPs = ${allowed_ips}
Endpoint = ${server_ip}:${server_port}
PersistentKeepalive = 25
CLIENT

  # Генерация QR-кода
  if command -v qrencode >/dev/null 2>&1; then
    qrencode -s 6 -o "$qr_file" < "$conf_file"
  fi

  echo "✅ Друг $name успешно добавлен!"
  echo "IP адрес: $client_ip"
  echo "Режим: $mode ($([ "$mode" = "smart" ] && echo "Защищенный сплит: Инста/Ютуб/Телега через VPN, банки и Госуслуги напрямую" || echo "Полный туннель"))"
  echo "Конфиг: $conf_file"

  # Если есть qrencode, выводим QR прямо в терминал
  if command -v qrencode >/dev/null 2>&1; then
    echo
    echo "QR-код для приложения AmneziaWG (отсканируй камерой в приложении):"
    qrencode -t ANSIUTF8 < "$conf_file" || true
  fi

  # Отправка конфига и QR в Telegram (если бот настроен)
  if [ -n "${TG_TOKEN:-}" ] && [ -n "${TG_CHAT_ID:-}" ]; then
    local API="https://api.telegram.org/bot${TG_TOKEN}"
    local desc_mode
    [ "$mode" = "smart" ] && desc_mode="🛡 <b>Режим:</b> Умный сплит (Инста, Ютуб, Телега через VPN; Госуслуги и банки напрямую — IP не палится!)" || desc_mode="🌐 <b>Режим:</b> Полный туннель (0.0.0.0/0)"

    local caption="👤 <b>Конфиг AmneziaWG для:</b> <code>${name}</code>%0A${desc_mode}%0A📱 Просто перешли этот файл или QR-код другу!"

    if [ -f "$qr_file" ]; then
      curl -s -m 30 -F "chat_id=${TG_CHAT_ID}" \
        -F "photo=@${qr_file}" \
        -F "caption=${caption}" \
        -F "parse_mode=HTML" \
        "${API}/sendPhoto" >/dev/null 2>&1 || true
    fi

    curl -s -m 30 -F "chat_id=${TG_CHAT_ID}" \
      -F "document=@${conf_file}" \
      -F "caption=📄 Файл конфигурации для импорта в AmneziaWG" \
      "${API}/sendDocument" >/dev/null 2>&1 || true

    echo "📲 Конфиг и QR-код отправлены тебе в Telegram!"
  fi
}

cmd_list() {
  echo "=== Список подключенных друзей (AmneziaWG) ==="
  printf "%-15s %-15s %-12s %-12s %-20s\n" "Имя" "IP" "Получено" "Отправлено" "Последний хэндшейк"
  echo "-------------------------------------------------------------------------------"

  local dump
  dump="$(awg_exec awg show awg0 dump 2>/dev/null || true)"
  
  if [ -f "$AWG_CONF" ]; then
    while IFS= read -r line; do
      if [[ "$line" =~ ^#\ (Friend|Peer):\ ([^[:space:]]+)\ \((10\.8\.1\.[0-9]+)\) ]]; then
        local fname="${BASH_REMATCH[2]}"
        local fip="${BASH_REMATCH[3]}"
        local rx="0 B" tx="0 B" last="Никогда"

        # Ищем в дампе awg
        local match
        match="$(echo "$dump" | grep -w "$fip/32" || true)"
        if [ -n "$match" ]; then
          local last_epoch rx_b tx_b
          last_epoch="$(echo "$match" | awk '{print $5}')"
          rx_b="$(echo "$match" | awk '{print $6}')"
          tx_b="$(echo "$match" | awk '{print $7}')"

          [ "$rx_b" -gt 0 ] 2>/dev/null && rx="$(numfmt --to=iec-i --suffix=B "$rx_b" 2>/dev/null || echo "${rx_b}B")"
          [ "$tx_b" -gt 0 ] 2>/dev/null && tx="$(numfmt --to=iec-i --suffix=B "$tx_b" 2>/dev/null || echo "${tx_b}B")"
          if [ "${last_epoch:-0}" -gt 0 ] 2>/dev/null; then
            local now diff
            now="$(date +%s)"
            diff=$((now - last_epoch))
            if [ "$diff" -lt 120 ]; then last="В сети (< 2 мин)"; else last="$((diff / 60)) мин назад"; fi
          fi
        fi
        printf "%-15s %-15s %-12s %-12s %-20s\n" "$fname" "$fip" "$rx" "$tx" "$last"
      fi
    done < "$AWG_CONF"
  else
    echo "Файл конфигурации $AWG_CONF не найден."
  fi
}

cmd_revoke() {
  local target="${1:-}"
  if [ -z "$target" ]; then
    echo "Использование: kit-friend revoke <ИМЯ_ИЛИ_IP>"
    exit 1
  fi

  local pub=""
  if [ -f "$AWG_CONF" ]; then
    # Ищем блок пира
    local line_num
    line_num=$(grep -n -E "# (Friend|Peer): ${target} |AllowedIPs = ${target}/32" "$AWG_CONF" | cut -d: -f1 | head -1 || true)
    if [ -n "$line_num" ]; then
      pub=$(sed -n "$((line_num, line_num + 5))p" "$AWG_CONF" | grep "PublicKey" | cut -d= -f2 | tr -d ' ' || true)
    fi
  fi

  if [ -n "$pub" ]; then
    awg_exec awg set awg0 peer "$pub" remove 2>/dev/null || true
    echo "Пир с ключом $pub удален из работающего интерфейса awg0."
  else
    echo "Пир не найден в работающем интерфейсе."
  fi

  rm -f "${CONFIGS_DIR}/${target}.conf" "${CONFIGS_DIR}/${target}.png"
  echo "Конфигурация $target отозвана."
}

case "${1:-}" in
  add) shift; cmd_add "$@" ;;
  list|ls) cmd_list ;;
  revoke|rm|del) shift; cmd_revoke "$@" ;;
  *)
    echo "kit-friend — управление доступом для друзей в AmneziaWG"
    echo
    echo "Команды:"
    echo "  kit-friend add <ИМЯ> [smart|full] — добавить друга, создать QR и отправить в Telegram"
    echo "  kit-friend list                    — показать список друзей, трафик и статус онлайн"
    echo "  kit-friend revoke <ИМЯ>            — удалить доступ у друга"
    exit 0
    ;;
esac
