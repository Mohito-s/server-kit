# Пример. Реальный файл создаётся на сервере: /etc/server-kit/config.env
# Можно передать переменные заранее, тогда скрипт не будет задавать вопросов:
#   TG_TOKEN=... TG_CHAT_ID=... WITH_DOCKER=1 WITH_NETDATA=0 bash install.sh
TG_TOKEN=""
TG_CHAT_ID=""
WITH_DOCKER="0"
WITH_NETDATA="0"
WITH_BOT="1"          # управление из Telegram (/status, /unban, /repair)
EXTRA_PORTS=""        # доп. порты для файрвола, например "8443/tcp 51820/udp"
EXTRA_SERVICES=""     # доп. сервисы для самопроверки, например "nginx remnawave"
